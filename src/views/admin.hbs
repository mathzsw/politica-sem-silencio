<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#111218">
    <title>Cadastrar perguntas | Política sem Silêncio</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * { box-sizing: border-box; }
        body {
            min-height: 100vh;
            margin: 0;
            padding: 40px 18px;
            background: #111218;
            color: #f5f5f7;
            font-family: Arial, sans-serif;
        }
        main {
            width: min(100%, 680px);
            margin: 0 auto;
            padding: clamp(22px, 5vw, 38px);
            background: #191a23;
            border: 1px solid #2c2d39;
            border-radius: 18px;
            box-shadow: 0 18px 55px rgba(0, 0, 0, .25);
        }
        .marca {
            margin: 0 0 10px;
            color: #a78bfa;
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }
        h1 {
            margin: 0;
            color: #f5f5f7;
            font-size: clamp(1.8rem, 5vw, 2.4rem);
        }
        .descricao {
            margin: 12px 0 28px;
            color: #b8b8c7;
            line-height: 1.6;
        }
        form { display: grid; gap: 15px; }
        label {
            display: grid;
            gap: 8px;
            color: #e5e5ee;
            font-size: .92rem;
            font-weight: 600;
        }
        input, textarea, select {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #383947;
            border-radius: 9px;
            outline: none;
            background: #111218;
            color: #f5f5f7;
            font: inherit;
        }
        input:focus, textarea:focus, select:focus {
            border-color: #9b72f2;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, .18);
        }
        textarea { resize: vertical; min-height: 105px; }
        select { cursor: pointer; }
        button {
            width: 100%;
            margin-top: 5px;
            padding: 14px 18px;
            border: 0;
            border-radius: 9px;
            background: #7c3aed;
            color: #fff;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s, transform .2s;
        }
        button:hover { background: #6d28d9; }
        button:active { transform: scale(.99); }
        #mensagem { min-height: 1.3em; color: #c4b5fd; line-height: 1.5; }
        .voltar {
            display: inline-block;
            margin-top: 10px;
            color: #c4b5fd;
            text-decoration: none;
        }
        .voltar:hover { color: #fff; text-decoration: underline; }
    </style>
</head>
<body>
    <main>
        <p class="marca">Política sem Silêncio</p>
        <h1>Cadastrar perguntas</h1>
        <p class="descricao">Preencha o enunciado, as quatro alternativas e selecione a resposta correta.</p>

        <form id="form-pergunta">
            <label>Enunciado
                <textarea name="enunciado" placeholder="Digite o enunciado da pergunta" required rows="3"></textarea>
            </label>
            <label>Alternativa A
                <input name="alternativaA" placeholder="Digite a alternativa A" required>
            </label>
            <label>Alternativa B
                <input name="alternativaB" placeholder="Digite a alternativa B" required>
            </label>
            <label>Alternativa C
                <input name="alternativaC" placeholder="Digite a alternativa C" required>
            </label>
            <label>Alternativa D
                <input name="alternativaD" placeholder="Digite a alternativa D" required>
            </label>
            <label>Resposta correta
                <select name="respostaCorreta" required>
                    <option value="">Selecione a resposta correta</option>
                    <option value="A">Alternativa A</option>
                    <option value="B">Alternativa B</option>
                    <option value="C">Alternativa C</option>
                    <option value="D">Alternativa D</option>
                </select>
            </label>
            <button type="submit">Salvar pergunta</button>
        </form>

        <p id="mensagem" role="status" aria-live="polite"></p>
        <a class="voltar" href="/">← Voltar ao início</a>
    </main>

    <script>
        const formulario = document.getElementById('form-pergunta');
        const mensagem = document.getElementById('mensagem');

        formulario.addEventListener('submit', async (evento) => {
            evento.preventDefault();
            const dados = Object.fromEntries(new FormData(formulario));
            mensagem.textContent = 'Salvando pergunta...';

            try {
                const resposta = await fetch('/perguntas', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dados)
                });
                const resultado = await resposta.json();

                if (!resposta.ok) {
                    mensagem.textContent = resultado.erro || 'Não foi possível salvar a pergunta.';
                    return;
                }

                mensagem.textContent = 'Pergunta cadastrada com sucesso!';
                formulario.reset();
            } catch (erro) {
                mensagem.textContent = 'Erro de conexão com o servidor. Tente novamente.';
            }
        });
    </script>
</body>
</html>
