<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sala de espera | Política sem Silêncio</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        [hidden] { display: none !important; }
        body { min-height: 100vh; background: #111218; color: #f5f5f7; }
        .sala { width: min(760px, 92%); margin: 0 auto; padding: 48px 0; }
        .sala__cabecalho { margin-bottom: 30px; }
        .sala__etiqueta { display: inline-block; color: #7c3aed; font-size: 12px; font-weight: 800; letter-spacing: 2px; }
        .sala__titulo { margin: 18px 0 12px; font-size: clamp(32px, 6vw, 48px); line-height: 1.12; }
        .sala__titulo span { color: #7c3aed; }
        .sala__descricao { color: #a4a4b0; line-height: 1.7; }
        .sala__cartao { margin-top: 22px; padding: 26px; border: 1px solid #30313e; border-radius: 16px; background: #191a24; }
        .sala__codigo { text-align: center; }
        .sala__codigo-legenda { display: block; color: #a4a4b0; font-size: 12px; font-weight: 700; letter-spacing: 2px; }
        .sala__codigo-valor { display: block; margin: 12px 0 20px; font-size: clamp(36px, 8vw, 48px); letter-spacing: 8px; }
        .sala__acoes { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
        .sala__botao { border: 1px solid #393a49; border-radius: 10px; padding: 13px 18px; background: #22232f; color: #f5f5f7; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
        .sala__botao--principal { border-color: #7c3aed; background: #7c3aed; color: #ffffff; }
        .sala__botao:disabled { opacity: .6; cursor: wait; }
        .sala__lista-cabecalho { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 18px; }
        .sala__lista-cabecalho h2 { margin: 0; font-size: 20px; }
        .sala__contador { color: #c4a9ff; font-size: 13px; font-weight: 700; }
        .sala__jogadores { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
        .sala__jogador { padding: 14px; border: 1px solid #30313e; border-radius: 10px; background: #22232f; overflow-wrap: anywhere; }
        .sala__vazia { grid-column: 1 / -1; padding: 20px 8px; color: #a4a4b0; text-align: center; line-height: 1.7; }
        .sala__inicio { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 28px; text-align: center; }
        .sala__mensagem, .sala__status { color: #a4a4b0; font-size: 13px; line-height: 1.7; }
        .sala__mensagem { max-width: 360px; margin: 0; }
        .sala__status { margin: 22px 0 0; padding-top: 16px; border-top: 1px solid #30313e; text-align: center; }
        @media (max-width: 480px) { .sala { padding: 28px 0; } .sala__cartao { padding: 20px; } .sala__codigo-valor { letter-spacing: 5px; } }
    </style>
</head>
<body>
    <main class="sala" id="sala" data-codigo="{{partida.codigo}}">
        <header class="sala__cabecalho">
            <span class="sala__etiqueta">POLÍTICA SEM SILÊNCIO · SALA DE ESPERA</span>
            <h1 class="sala__titulo">Sua partida <span>está pronta.</span></h1>
            <p class="sala__descricao">Compartilhe o código com os participantes. Quando todos estiverem prontos, o apresentador poderá iniciar o quiz.</p>
        </header>

        <section class="sala__cartao sala__codigo">
            <span class="sala__codigo-legenda">CÓDIGO DA PARTIDA</span>
            <strong class="sala__codigo-valor" id="codigo-partida">{{partida.codigo}}</strong>
            <div class="sala__acoes">
                <button class="sala__botao sala__botao--principal" id="copiar-codigo" type="button">Copiar código</button>
                <a class="sala__botao" href="/">Voltar ao início</a>
            </div>
        </section>

        <section class="sala__cartao">
            <div class="sala__lista-cabecalho">
                <h2>Participantes</h2>
                <span class="sala__contador" id="contador-jogadores">{{jogadores.length}} participantes</span>
            </div>
            <div class="sala__jogadores" id="lista-jogadores" aria-live="polite">
                {{#each jogadores}}
                    <article class="sala__jogador">{{this.nome}}</article>
                {{else}}
                    <p class="sala__vazia">Ainda não há participantes.<br>Compartilhe o código para começar!</p>
                {{/each}}
            </div>
            <div class="sala__inicio">
                <button class="sala__botao sala__botao--principal" id="iniciar-quiz" type="button">Iniciar quiz →</button>
                <p class="sala__mensagem" id="mensagem-inicio" role="status">Quando todos estiverem prontos, inicie o quiz.</p>
            </div>
            <p class="sala__status" id="status-atualizacao">Lista atualizada automaticamente.</p>
        </section>
    </main>

    <script>
        const sala = document.getElementById('sala');
        const codigo = sala.dataset.codigo;
        const tokenApresentador = sessionStorage.getItem('chave-apresentador-' + codigo);
        const botaoIniciar = document.getElementById('iniciar-quiz');
        const mensagemInicio = document.getElementById('mensagem-inicio');
        const listaJogadores = document.getElementById('lista-jogadores');
        const contadorJogadores = document.getElementById('contador-jogadores');
        const statusAtualizacao = document.getElementById('status-atualizacao');
        const botaoCopiar = document.getElementById('copiar-codigo');
        let atualizando = false;
        let iniciando = false;

        if (!tokenApresentador) {
            botaoIniciar.hidden = true;
            mensagemInicio.textContent = 'Aguardando o apresentador iniciar o quiz.';
        }

        function abrirQuiz() {
            window.location.replace('/partidas/' + encodeURIComponent(codigo) + '/quiz');
        }

        function mostrarJogadores(jogadores) {
            contadorJogadores.textContent = jogadores.length + ' ' + (jogadores.length === 1 ? 'participante' : 'participantes');
            listaJogadores.replaceChildren();

            if (!jogadores.length) {
                const vazio = document.createElement('p');
                vazio.className = 'sala__vazia';
                vazio.textContent = 'Ainda não há participantes. Compartilhe o código para começar!';
                listaJogadores.appendChild(vazio);
                return;
            }

            jogadores.forEach((jogador) => {
                const item = document.createElement('article');
                item.className = 'sala__jogador';
                item.textContent = jogador.nome;
                listaJogadores.appendChild(item);
            });
        }

        async function atualizarSala() {
            if (atualizando) return;
            atualizando = true;

            try {
                const resposta = await fetch('/partidas/' + encodeURIComponent(codigo) + '/jogadores');
                const dados = await resposta.json();

                if (!resposta.ok) throw new Error(dados.erro || 'Não foi possível atualizar a sala.');

                if (dados.status === 'em_andamento' || dados.status === 'finalizada') {
                    abrirQuiz();
                    return;
                }

                mostrarJogadores(dados.jogadores || []);
                statusAtualizacao.textContent = 'Lista atualizada automaticamente.';
            } catch (erro) {
                statusAtualizacao.textContent = 'Não foi possível atualizar a sala. Tentando novamente...';
                console.error('Erro ao atualizar sala:', erro);
            } finally {
                atualizando = false;
            }
        }

        botaoIniciar.addEventListener('click', async () => {
            if (!tokenApresentador || iniciando) return;

            iniciando = true;
            botaoIniciar.disabled = true;
            botaoIniciar.textContent = 'Iniciando quiz...';
            mensagemInicio.textContent = 'Preparando a primeira pergunta.';

            try {
                const resposta = await fetch('/partidas/' + encodeURIComponent(codigo) + '/iniciar', {
                    method: 'POST',
                    headers: { 'X-Chave-Apresentador': tokenApresentador }
                });
                const dados = await resposta.json();

                if (!resposta.ok) throw new Error(dados.erro || 'Não foi possível iniciar o quiz.');

                abrirQuiz();
            } catch (erro) {
                mensagemInicio.textContent = erro.message;
                botaoIniciar.disabled = false;
                botaoIniciar.textContent = 'Iniciar quiz →';
                iniciando = false;
            }
        });

        botaoCopiar.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(codigo);
                botaoCopiar.textContent = 'Código copiado!';
            } catch (erro) {
                mensagemInicio.textContent = 'O código da partida é ' + codigo + '. Copie-o manualmente.';
            }
        });

        atualizarSala();
        setInterval(atualizarSala, 2000);
    </script>
</body>
</html>