<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz | Política sem Silêncio</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background: #111218; color: #f5f5f7; min-height: 100vh; }
        .quiz-pagina { width: min(900px, 92%); margin: 0 auto; padding: 48px 0; }
        .quiz-cabecalho { margin-bottom: 32px; }
        .quiz-etiqueta { display: inline-block; color: #9b72f2; font-size: 12px; font-weight: 700; letter-spacing: 2px; margin-bottom: 18px; }
        .quiz-titulo { font-size: clamp(30px, 6vw, 48px); margin: 0 0 12px; }
        .quiz-descricao { color: #a4a4b0; line-height: 1.6; }
        .quiz-cartao { background: #191a24; border: 1px solid #30313e; border-radius: 18px; padding: 30px; }
        .quiz-progresso { color: #9b72f2; font-size: 13px; font-weight: 700; margin-bottom: 22px; }
        .quiz-pergunta { font-size: clamp(21px, 4vw, 30px); line-height: 1.4; margin-bottom: 28px; }
        .quiz-alternativas { display: grid; gap: 12px; }
        .quiz-alternativa { width: 100%; padding: 17px; border: 1px solid #393a49; border-radius: 12px; background: #22232f; color: #f5f5f7; text-align: left; font-size: 15px; line-height: 1.5; cursor: pointer; transition: border-color .2s, background .2s; }
        .quiz-alternativa:hover:not(:disabled) { border-color: #7c3aed; background: #292137; }
        .quiz-alternativa:disabled { cursor: default; opacity: .8; }
        .quiz-feedback { margin-top: 20px; line-height: 1.6; }
        .quiz-acoes { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
        .quiz-botao { display: inline-block; border: none; border-radius: 10px; padding: 14px 20px; background: #7c3aed; color: white; font-weight: 700; text-decoration: none; cursor: pointer; }
        .quiz-botao:hover:not(:disabled) { background: #9b72f2; }
        .quiz-botao:disabled { opacity: .5; cursor: not-allowed; }
        .quiz-ranking { display: grid; gap: 12px; margin-top: 24px; }
        .quiz-ranking-item { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 17px; background: #22232f; border: 1px solid #393a49; border-radius: 12px; }
        .quiz-ranking-item:first-child { border-color: #9b72f2; background: #241c35; }
        .quiz-ranking-nome { display: flex; align-items: center; gap: 12px; }
        .quiz-ranking-posicao { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: #302443; color: #c4a9ff; font-weight: 800; }
        .quiz-ranking-pontos { color: #c4a9ff; font-weight: 700; white-space: nowrap; }
        .quiz-ranking-vazio { color: #a4a4b0; padding: 16px 0; }
        .quiz-painel-pontuacao { margin-top: 22px; }
        .quiz-painel-pontuacao h2 { font-size: 20px; margin-bottom: 8px; }
        .quiz-painel-pontuacao p { color: #a4a4b0; font-size: 13px; }
        .quiz-erro { color: #ff8585; }
        [hidden] { display: none !important; }
        @media (max-width: 480px) { .quiz-pagina { padding: 28px 0; } .quiz-cartao { padding: 20px; } .quiz-ranking-item { padding: 13px; } }
    </style>
</head>
<body>
    <main class="quiz-pagina" id="quiz" data-codigo="{{codigo}}">
        <header class="quiz-cabecalho">
            <span class="quiz-etiqueta">POLÍTICA SEM SILÊNCIO</span>
            <h1 class="quiz-titulo">Hora de <span style="color:#9b72f2">jogar.</span></h1>
            <p class="quiz-descricao" id="quiz-descricao">Leia a pergunta e escolha sua resposta.</p>
        </header>

        <section class="quiz-cartao" id="painel-pergunta">
            <p class="quiz-progresso" id="progresso-pergunta">Carregando pergunta...</p>
            <h2 class="quiz-pergunta" id="enunciado-pergunta"></h2>
            <div class="quiz-alternativas" id="alternativas"></div>
            <p class="quiz-feedback" id="feedback-resposta" role="status"></p>
            <div class="quiz-acoes">
                <a class="quiz-botao" href="/partidas/{{codigo}}">Sala de espera</a>
                <button class="quiz-botao" id="proxima-pergunta" type="button" hidden>Próxima pergunta →</button>
            </div>
            <section class="quiz-painel-pontuacao" id="painel-pontuacao" hidden>
                <h2>Placar ao vivo</h2>
                <p>A pontuação é atualizada conforme os participantes acertam.</p>
                <div class="quiz-ranking" id="ranking-ao-vivo"></div>
            </section>
        </section>

        <section class="quiz-cartao" id="painel-final" hidden>
            <span class="quiz-etiqueta">PARTIDA FINALIZADA</span>
            <h2 class="quiz-titulo">Classificação final</h2>
            <p class="quiz-descricao">Cada resposta correta vale 1 ponto. Veja o resultado final:</p>
            <div class="quiz-ranking" id="ranking-final"></div>
            <div class="quiz-acoes">
                <a href="/" class="quiz-botao">Voltar ao início</a>
            </div>
        </section>
    </main>

    <script>
        const quiz = document.getElementById('quiz');
        const codigo = quiz.dataset.codigo;
        const jogadorId = localStorage.getItem('jogador-' + codigo);
        const chaveApresentador = sessionStorage.getItem('chave-apresentador-' + codigo);
        const ehApresentador = Boolean(chaveApresentador);

        const progresso = document.getElementById('progresso-pergunta');
        const enunciado = document.getElementById('enunciado-pergunta');
        const alternativas = document.getElementById('alternativas');
        const feedback = document.getElementById('feedback-resposta');
        const botaoProxima = document.getElementById('proxima-pergunta');
        const painelPergunta = document.getElementById('painel-pergunta');
        const painelFinal = document.getElementById('painel-final');
        const rankingFinal = document.getElementById('ranking-final');
        const rankingAoVivo = document.getElementById('ranking-ao-vivo');
        const painelPontuacao = document.getElementById('painel-pontuacao');
        const descricao = document.getElementById('quiz-descricao');

        let perguntaAtualId = null;
        let respostaEnviada = false;
        let carregando = false;
        let partidaFinalizada = false;
        let carregandoPlacar = false;

        if (!jogadorId && !ehApresentador) {
            descricao.textContent = 'Sua identificação não foi encontrada. Entre na partida pelo código antes de responder.';
            painelPergunta.hidden = true;
        }

        if (ehApresentador) {
            descricao.textContent = 'Você é o apresentador. Acompanhe as perguntas, o placar ao vivo e controle o ritmo do quiz.';
            botaoProxima.hidden = false;
            painelPontuacao.hidden = false;
        }

        async function carregarPergunta() {
            if (carregando || partidaFinalizada || (!jogadorId && !ehApresentador)) return;
            carregando = true;

            try {
                const resposta = await fetch('/partidas/' + encodeURIComponent(codigo) + '/pergunta');
                const dados = await resposta.json();

                if (!resposta.ok) throw new Error(dados.erro || 'Não foi possível carregar a pergunta.');

                if (dados.status === 'aguardando') {
                    window.location.replace('/partidas/' + encodeURIComponent(codigo));
                    return;
                }

                if (dados.status === 'finalizada') {
                    mostrarRanking(dados.ranking || []);
                    return;
                }

                if (dados.pergunta && dados.pergunta.id !== perguntaAtualId) {
                    mostrarPergunta(dados);
                }
            } catch (erro) {
                feedback.textContent = erro.message;
                feedback.className = 'quiz-feedback quiz-erro';
            } finally {
                carregando = false;
            }
        }

        function mostrarPergunta(dados) {
            perguntaAtualId = dados.pergunta.id;
            respostaEnviada = false;
            progresso.textContent = 'PERGUNTA ' + dados.numeroPergunta + ' DE ' + dados.totalPerguntas;
            enunciado.textContent = dados.pergunta.enunciado;
            feedback.textContent = '';
            feedback.className = 'quiz-feedback';
            feedback.style.color = '';
            alternativas.replaceChildren();

            const opcoes = [
                ['A', dados.pergunta.alternativaA],
                ['B', dados.pergunta.alternativaB],
                ['C', dados.pergunta.alternativaC],
                ['D', dados.pergunta.alternativaD]
            ];

            opcoes.forEach(([letra, texto]) => {
                const botao = document.createElement('button');
                botao.type = 'button';
                botao.className = 'quiz-alternativa';
                botao.textContent = letra + ' — ' + texto;

                if (ehApresentador) {
                    botao.disabled = true;
                    botao.title = 'Somente os participantes respondem.';
                } else {
                    botao.addEventListener('click', () => enviarResposta(letra));
                    botao.disabled = respostaEnviada;
                }

                alternativas.appendChild(botao);
            });

            botaoProxima.hidden = !ehApresentador;
            botaoProxima.disabled = false;
            botaoProxima.textContent = 'Próxima pergunta →';
            descricao.textContent = ehApresentador
                ? 'Você controla a partida. A pontuação é atualizada no placar ao vivo.'
                : 'Selecione uma alternativa. Você só pode responder uma vez por pergunta.';
        }

        async function enviarResposta(alternativa) {
            if (ehApresentador || respostaEnviada || !perguntaAtualId || !jogadorId) return;

            respostaEnviada = true;
            alternativas.querySelectorAll('button').forEach(botao => { botao.disabled = true; });
            feedback.textContent = 'Verificando resposta...';

            try {
                const resposta = await fetch('/partidas/' + encodeURIComponent(codigo) + '/responder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        jogadorId: Number(jogadorId),
                        perguntaId: perguntaAtualId,
                        alternativa
                    })
                });

                const dados = await resposta.json();
                if (!resposta.ok) throw new Error(dados.erro || 'Não foi possível registrar sua resposta.');

                feedback.textContent = dados.mensagem + ' Sua pontuação: ' + dados.pontuacao + (dados.pontuacao === 1 ? ' ponto.' : ' pontos.');
                feedback.style.color = dados.correta ? '#9b72f2' : '#ff8585';
            } catch (erro) {
                respostaEnviada = false;
                feedback.textContent = erro.message;
                feedback.className = 'quiz-feedback quiz-erro';
                alternativas.querySelectorAll('button').forEach(botao => { botao.disabled = false; });
            }
        }

        async function carregarPlacar() {
            if (!ehApresentador || carregandoPlacar || partidaFinalizada) return;
            carregandoPlacar = true;

            try {
                const resposta = await fetch('/partidas/' + encodeURIComponent(codigo) + '/jogadores');
                const dados = await resposta.json();
                if (!resposta.ok) throw new Error(dados.erro || 'Não foi possível carregar o placar.');

                const jogadores = (dados.jogadores || []).sort((a, b) => b.pontuacao - a.pontuacao);
                rankingAoVivo.replaceChildren();

                if (!jogadores.length) {
                    const vazio = document.createElement('p');
                    vazio.className = 'quiz-ranking-vazio';
                    vazio.textContent = 'Aguardando participantes.';
                    rankingAoVivo.appendChild(vazio);
                    return;
                }

                jogadores.forEach((jogador, indice) => {
                    const item = document.createElement('article');
                    item.className = 'quiz-ranking-item';

                    const nome = document.createElement('span');
                    nome.className = 'quiz-ranking-nome';

                    const posicao = document.createElement('span');
                    posicao.className = 'quiz-ranking-posicao';
                    posicao.textContent = indice + 1;

                    const textoNome = document.createElement('span');
                    textoNome.textContent = jogador.nome;
                    nome.append(posicao, textoNome);

                    const pontos = document.createElement('span');
                    pontos.className = 'quiz-ranking-pontos';
                    pontos.textContent = jogador.pontuacao + (jogador.pontuacao === 1 ? ' ponto' : ' pontos');

                    item.append(nome, pontos);
                    rankingAoVivo.appendChild(item);
                });
            } catch (erro) {
                console.error('Erro ao atualizar placar:', erro);
            } finally {
                carregandoPlacar = false;
            }
        }

        async function avancarPergunta() {
            if (!ehApresentador || botaoProxima.disabled) return;

            botaoProxima.disabled = true;
            botaoProxima.textContent = 'Avançando...';

            try {
                const resposta = await fetch('/partidas/' + encodeURIComponent(codigo) + '/proxima', {
                    method: 'POST',
                    headers: { 'X-Chave-Apresentador': chaveApresentador }
                });

                const dados = await resposta.json();
                if (!resposta.ok) throw new Error(dados.erro || 'Não foi possível avançar.');

                if (dados.status === 'finalizada') {
                    await carregarPergunta();
                } else {
                    perguntaAtualId = null;
                    await carregarPergunta();
                }
            } catch (erro) {
                feedback.textContent = erro.message;
                feedback.className = 'quiz-feedback quiz-erro';
            } finally {
                botaoProxima.disabled = false;
                if (!partidaFinalizada) botaoProxima.textContent = 'Próxima pergunta →';
            }
        }

        function mostrarRanking(jogadores) {
            partidaFinalizada = true;
            painelPergunta.hidden = true;
            painelFinal.hidden = false;
            rankingFinal.replaceChildren();

            if (!jogadores.length) {
                const vazio = document.createElement('p');
                vazio.className = 'quiz-ranking-vazio';
                vazio.textContent = 'Nenhum participante encontrado.';
                rankingFinal.appendChild(vazio);
                return;
            }

            jogadores.forEach((jogador, indice) => {
                const item = document.createElement('article');
                item.className = 'quiz-ranking-item';

                const nome = document.createElement('span');
                nome.className = 'quiz-ranking-nome';

                const posicao = document.createElement('span');
                posicao.className = 'quiz-ranking-posicao';
                posicao.textContent = indice + 1;

                const textoNome = document.createElement('span');
                textoNome.textContent = (indice === 0 ? '🏆 ' : '') + jogador.nome;
                nome.append(posicao, textoNome);

                const pontos = document.createElement('span');
                pontos.className = 'quiz-ranking-pontos';
                pontos.textContent = jogador.pontuacao + (jogador.pontuacao === 1 ? ' ponto' : ' pontos');

                item.append(nome, pontos);
                rankingFinal.appendChild(item);
            });
        }

        botaoProxima.addEventListener('click', avancarPergunta);
        carregarPergunta();
        carregarPlacar();
        setInterval(carregarPergunta, 2000);
        setInterval(carregarPlacar, 2000);
    </script>
</body>
</html>