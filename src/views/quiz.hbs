<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz | Política sem Silêncio</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #111218;
            color: #f5f5f7;
            min-height: 100vh;
        }

        .quiz-pagina {
            width: min(760px, 92%);
            margin: 0 auto;
            padding: 48px 0;
        }

        .quiz-cabecalho {
            margin-bottom: 32px;
        }

        .quiz-etiqueta {
            display: inline-block;
            color: #c7f36b;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            margin-bottom: 18px;
        }

        .quiz-titulo {
            font-size: clamp(30px, 6vw, 48px);
            margin: 0 0 12px;
        }

        .quiz-descricao {
            color: #a4a4b0;
            line-height: 1.6;
        }

        .quiz-cartao {
            background: #191a24;
            border: 1px solid #30313e;
            border-radius: 18px;
            padding: 30px;
        }

        .quiz-progresso {
            color: #c7f36b;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 22px;
        }

        .quiz-pergunta {
            font-size: clamp(21px, 4vw, 30px);
            line-height: 1.4;
            margin-bottom: 28px;
        }

        .quiz-alternativas {
            display: grid;
            gap: 12px;
        }

        .quiz-alternativa {
            width: 100%;
            padding: 17px;
            border: 1px solid #393a49;
            border-radius: 12px;
            background: #22232f;
            color: #f5f5f7;
            text-align: left;
            font-size: 15px;
            line-height: 1.5;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
        }

        .quiz-alternativa:hover:not(:disabled) {
            border-color: #7c3aed;
            background: #292137;
        }

        .quiz-alternativa:disabled {
            cursor: default;
            opacity: 0.8;
        }

        .quiz-feedback {
            margin-top: 20px;
            line-height: 1.6;
        }

        .quiz-acoes {
            display: flex;
            justify-content: flex-end;
            margin-top: 24px;
        }

        .quiz-botao {
            border: none;
            border-radius: 10px;
            padding: 14px 20px;
            background: #c7f36b;
            color: #111218;
            font-weight: 700;
            cursor: pointer;
        }

        .quiz-botao:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .quiz-ranking {
            display: grid;
            gap: 12px;
            margin-top: 24px;
        }

        .quiz-ranking-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 17px;
            background: #22232f;
            border: 1px solid #393a49;
            border-radius: 12px;
        }

        .quiz-ranking-item:first-child {
            border-color: #c7f36b;
        }

        .quiz-ranking-pontos {
            color: #c7f36b;
            font-weight: 700;
            white-space: nowrap;
        }

        .quiz-erro {
            color: #ff8585;
        }

        [hidden] {
            display: none !important;
        }

        @media (max-width: 480px) {
            .quiz-pagina {
                padding: 28px 0;
            }

            .quiz-cartao {
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <main class="quiz-pagina" id="quiz" data-codigo="{{codigo}}">
        <header class="quiz-cabecalho">
            <span class="quiz-etiqueta">POLÍTICA SEM SILÊNCIO</span>
            <h1 class="quiz-titulo">Hora de <span style="color:#c7f36b">jogar.</span></h1>
            <p class="quiz-descricao" id="quiz-descricao">
                Leia a pergunta e escolha sua resposta.
            </p>
        </header>

        <section class="quiz-cartao" id="painel-pergunta">
            <p class="quiz-progresso" id="progresso-pergunta">
                Carregando pergunta...
            </p>

            <h2 class="quiz-pergunta" id="enunciado-pergunta"></h2>

            <div class="quiz-alternativas" id="alternativas"></div>

            <p class="quiz-feedback" id="feedback-resposta" role="status"></p>

            <div class="quiz-acoes">
                <button class="quiz-botao" id="proxima-pergunta" type="button" hidden>
                    Próxima pergunta →
                </button>
            </div>
        </section>

        <section class="quiz-cartao" id="painel-final" hidden>
            <span class="quiz-etiqueta">PARTIDA FINALIZADA</span>
            <h2 class="quiz-titulo">Classificação final</h2>
            <p class="quiz-descricao">Confira a pontuação dos participantes.</p>
            <div class="quiz-ranking" id="ranking-final"></div>
            <div class="quiz-acoes">
                <a href="/" class="quiz-botao" style="text-decoration:none">
                    Voltar ao início
                </a>
            </div>
        </section>
    </main>

    <script>
        const quiz = document.getElementById('quiz');
        const codigo = quiz.dataset.codigo;

        const jogadorId = localStorage.getItem(`jogador-${codigo}`);
        const chaveApresentador = sessionStorage.getItem(`chave-apresentador-${codigo}`);

        const progresso = document.getElementById('progresso-pergunta');
        const enunciado = document.getElementById('enunciado-pergunta');
        const alternativas = document.getElementById('alternativas');
        const feedback = document.getElementById('feedback-resposta');
        const botaoProxima = document.getElementById('proxima-pergunta');
        const painelPergunta = document.getElementById('painel-pergunta');
        const painelFinal = document.getElementById('painel-final');
        const rankingFinal = document.getElementById('ranking-final');
        const descricao = document.getElementById('quiz-descricao');

        let perguntaAtualId = null;
        let respostaEnviada = false;
        let carregando = false;
        let partidaFinalizada = false;

        if (!jogadorId) {
            descricao.textContent = 'Não encontramos sua identificação nesta partida. Entre novamente pelo código da sala.';
            painelPergunta.hidden = true;
        }

        if (chaveApresentador) {
            botaoProxima.hidden = false;
        }

        async function carregarPergunta() {
            if (carregando || partidaFinalizada || !jogadorId) {
                return;
            }

            carregando = true;

            try {
                const resposta = await fetch(
                    `/partidas/${encodeURIComponent(codigo)}/pergunta`
                );

                const dados = await resposta.json();

                if (!resposta.ok) {
                    throw new Error(dados.erro || 'Não foi possível carregar a pergunta.');
                }

                if (dados.status === 'aguardando') {
                    window.location.href = `/partidas/${encodeURIComponent(codigo)}`;
                    return;
                }

                if (dados.status === 'finalizada') {
                    mostrarRanking(dados.ranking || []);
                    return;
                }

                if (!dados.pergunta) {
                    return;
                }

                if (dados.pergunta.id !== perguntaAtualId) {
                    mostrarPergunta(dados);
                }
            } catch (erro) {
                feedback.textContent = erro.message;
                feedback.className = 'quiz-feedback quiz-erro';
            } finally {
                carregando = false;
            }
        }

        function mostrarPergunta(dados) {
            perguntaAtualId = dados.pergunta.id;
            respostaEnviada = false;

            progresso.textContent =
                `PERGUNTA ${dados.numeroPergunta} DE ${dados.totalPerguntas}`;

            enunciado.textContent = dados.pergunta.enunciado;
            feedback.textContent = '';
            feedback.className = 'quiz-feedback';

            alternativas.replaceChildren();

            const opcoes = [
                ['A', dados.pergunta.alternativaA],
                ['B', dados.pergunta.alternativaB],
                ['C', dados.pergunta.alternativaC],
                ['D', dados.pergunta.alternativaD]
            ];

            opcoes.forEach(([letra, texto]) => {
                const botao = document.createElement('button');

                botao.type = 'button';
                botao.className = 'quiz-alternativa';
                botao.textContent = `${letra} — ${texto}`;

                botao.addEventListener('click', () => {
                    enviarResposta(letra);
                });

                alternativas.appendChild(botao);
            });

            botaoProxima.hidden = !chaveApresentador;
            botaoProxima.disabled = false;
        }

        async function enviarResposta(alternativa) {
            if (respostaEnviada || !perguntaAtualId || !jogadorId) {
                return;
            }

            respostaEnviada = true;

            const botoes = alternativas.querySelectorAll('button');
            botoes.forEach(botao => {
                botao.disabled = true;
            });

            try {
                const resposta = await fetch(
                    `/partidas/${encodeURIComponent(codigo)}/responder`,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            jogadorId: Number(jogadorId),
                            perguntaId: perguntaAtualId,
                            alternativa
                        })
                    }
                );

                const dados = await resposta.json();

                if (!resposta.ok) {
                    throw new Error(dados.erro || 'Não foi possível registrar sua resposta.');
                }

                feedback.textContent =
                    `${dados.mensagem} Sua pontuação: ${dados.pontuacao}.`;

                feedback.className = 'quiz-feedback';

                if (dados.correta) {
                    feedback.style.color = '#c7f36b';
                } else {
                    feedback.style.color = '#ff8585';
                }
            } catch (erro) {
                respostaEnviada = false;
                feedback.textContent = erro.message;
                feedback.className = 'quiz-feedback quiz-erro';

                botoes.forEach(botao => {
                    botao.disabled = false;
                });
            }
        }

        async function avancarPergunta() {
            if (!chaveApresentador || botaoProxima.disabled) {
                return;
            }

            botaoProxima.disabled = true;

            try {
                const resposta = await fetch(
                    `/partidas/${encodeURIComponent(codigo)}/proxima`,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Chave-Apresentador': chaveApresentador
                        }
                    }
                );

                const dados = await resposta.json();

                if (!resposta.ok) {
                    throw new Error(dados.erro || 'Não foi possível avançar.');
                }

                if (dados.status === 'finalizada') {
                    await carregarPergunta();
                } else {
                    await carregarPergunta();
                }
            } catch (erro) {
                feedback.textContent = erro.message;
                feedback.className = 'quiz-feedback quiz-erro';
            } finally {
                botaoProxima.disabled = false;
            }
        }

        function mostrarRanking(jogadores) {
            partidaFinalizada = true;
            painelPergunta.hidden = true;
            painelFinal.hidden = false;

            rankingFinal.replaceChildren();

            if (!jogadores.length) {
                rankingFinal.textContent = 'Nenhum participante encontrado.';
                return;
            }

            jogadores.forEach((jogador, indice) => {
                const item = document.createElement('article');
                item.className = 'quiz-ranking-item';

                const nome = document.createElement('span');
                nome.textContent = `${indice + 1}º lugar — ${jogador.nome}`;

                const pontos = document.createElement('span');
                pontos.className = 'quiz-ranking-pontos';
                pontos.textContent =
                    `${jogador.pontuacao} ${jogador.pontuacao === 1 ? 'ponto' : 'pontos'}`;

                item.append(nome, pontos);
                rankingFinal.appendChild(item);
            });
        }

        botaoProxima.addEventListener('click', avancarPergunta);

        carregarPergunta();
        setInterval(carregarPergunta, 2000);
    </script>
</body>
</html>